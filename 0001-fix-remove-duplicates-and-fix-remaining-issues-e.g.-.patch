+ */
+void pbuild_tran_matrix(
+                        Ppoint *pt,                /* fixed point */
+                        Pvec *shift,               /* shift vector */
+                        Pfloat angle,              /* rotation angle */
+                        Pvec *scale,               /* scale vector */
